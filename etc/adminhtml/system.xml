<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="datareporter" >
            <group id="webcare" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WebCare</label>
                <field id="webcache_url" translate="label,comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Webcache URL</label>
                    <comment>URL where to retrieve the WebCare resources from excluding account information and type</comment>
                </field>
                <field id="language_code" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Add store language to external resource</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="enable_imprint" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Imprint</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="enable_privacy_notice" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Privacy Notice</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="enable_cookie_banner" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Cookie Banner</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="enable_cookie_banner_options" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Custom Cookie Banner Options</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                    </depends>
                </field>
                <field id="enable_cookie_banner_custom_redirect" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Cookie Banner custom redirect after consent</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                    </depends>
                </field>
                <field id="loader_mode" translate="label,comment" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loader Mode (CSP/SRI compliant)</label>
                    <comment><![CDATA[Enable Loader integration for CSP/SRI compliance. When enabled, the banner is loaded via the Loader script instead of direct banner files.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                    </depends>
                </field>
                <field id="loader_url" translate="label,comment" type="text" sortOrder="81" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loader URL</label>
                    <comment><![CDATA[Base URL for the Loader script (e.g., https://webcachex-eu.datareporter.eu/loader/v5/cmp-load.js)]]></comment>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                        <field id="loader_mode">1</field>
                    </depends>
                </field>
                <field id="loader_integration_key" translate="label,comment" type="text" sortOrder="82" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Loader Integration Key (optional)</label>
                    <comment><![CDATA[Optional: WebCare Integration Key for the Loader. If empty, it will be auto-generated from Client ID, Organisation ID and Website ID.]]></comment>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                        <field id="loader_mode">1</field>
                    </depends>
                </field>
                <field id="loader_sri_hash" translate="label,comment" type="text" sortOrder="83" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>SRI Hash</label>
                    <comment><![CDATA[Subresource Integrity hash for the Loader script (e.g., sha384-Yh6XuJwOlmI2r/DqXWGw4mGoFjpAsmouYCyW6xJV4te0MF+9PzMBsOXsDwvqSYUu). Leave empty to disable SRI.]]></comment>
                    <depends>
                        <field id="enable_cookie_banner">1</field>
                        <field id="loader_mode">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
